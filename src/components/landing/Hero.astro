---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero.jpg';

interface Props {
	eyebrow: string;
	title: string;
	subtitle: string;
	ctaPrimary: { href: string; label: string };
	ctaSecondary: { href: string; label: string };
	imageAlt: string;
}

const { eyebrow, title, subtitle, ctaPrimary, ctaSecondary, imageAlt } = Astro.props;
---

<section class="hero">
	<Image src={heroImage} alt={imageAlt} width={1600} height={900} class="hero-image" priority />
	<div class="hero-overlay"></div>
	<div class="container hero-content">
		<span class="eyebrow eyebrow-light">{eyebrow}</span>
		<h1>{title}</h1>
		<p class="subtitle">{subtitle}</p>
		<div class="cta-group">
			<a href={ctaPrimary.href} class="btn btn-primary">{ctaPrimary.label}</a>
			<a href={ctaSecondary.href} class="btn btn-secondary btn-on-image">{ctaSecondary.label}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 88vh;
		display: flex;
		align-items: flex-end;
		border-bottom: none;
		padding: 0;
		overflow: hidden;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(47, 42, 31, 0.05) 0%, rgba(47, 42, 31, 0.7) 100%);
	}

	.hero-content {
		position: relative;
		padding-bottom: 4.5em;
		padding-top: 4em;
		color: #fff;
		max-width: 40em;
		margin: 0 auto;
		text-align: center;
	}

	.eyebrow-light {
		color: #f1e8d6;
		text-align: center;
	}

	h1 {
		color: #fff;
		font-size: 2.8em;
		margin-bottom: 0.4em;
		white-space: pre-line;
	}

	.subtitle {
		font-size: 1.15em;
		color: rgba(255, 255, 255, 0.88);
		max-width: 32em;
		margin-left: auto;
		margin-right: auto;
	}

	.cta-group {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em;
		margin-top: 1.6em;
	}

	.cta-group .btn-primary,
	.btn-on-image {
		background: transparent;
		border-color: var(--color-panel);
		color: #fff;
	}

	.cta-group .btn-primary:hover,
	.btn-on-image:hover {
		background: var(--color-panel-sea);
		border-color: var(--color-panel-sea);
		color: var(--color-fg-bold);
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 2.1em;
		}
	}
</style>
