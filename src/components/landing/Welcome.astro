---
import { Image } from 'astro:assets';

interface WelcomeImage {
	src: ImageMetadata;
	alt: string;
}

interface Props {
	eyebrow: string;
	title: string;
	paragraphs: string[];
	images: WelcomeImage[];
}

const { eyebrow, title, paragraphs, images } = Astro.props;
---

<section id="welcome">
	<div class="container text-center welcome-header">
		<span class="eyebrow">{eyebrow}</span>
		<h2>{title}</h2>
	</div>

	<div class="container welcome-text">
		{paragraphs.map((p) => <p class="text-justify">{p}</p>)}
	</div>

	<div class="container">
		<div class="welcome-photos">
			{
				images.map((img) => (
					<div class="welcome-photo">
						<Image src={img.src} alt={img.alt} width={500} height={375} />
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.welcome-header {
		margin-bottom: 2.5em;
	}

	.welcome-photos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
		margin-top: 2.5em;
	}

	.welcome-photo img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--border-radius);
	}

	.welcome-text {
		max-width: 46em;
		margin: 0 auto;
	}

	.welcome-text p {
		color: var(--color-fg);
	}

	@media (max-width: 640px) {
		.welcome-photos {
			grid-template-columns: 1fr;
		}
	}
</style>
