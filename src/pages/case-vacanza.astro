function buildGallery(title: string, images: ImageMetadata[], plan: ImageMetadata) {
	return [
		...images.map((src, i) => ({ src, alt: i === 0 ? title : `${title}, foto ${i + 1}` })),
		{ src: plan, alt: `Planimetria, ${title}` },
	];
}

const apartments = [
	{
		title: 'Bilocale 2-4 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura e divano letto (due letti singoli)', 'Camera matrimoniale', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planBilocale24,
		planIconAlt: 'Planimetria Bilocale 2-4 persone',
		gallery: buildGallery(
			'Bilocale 2-4 persone',
			[bilocale24_1, bilocale24_2, bilocale24_3, bilocale24_4, bilocale24_5, bilocale24_6, bilocale24_7, bilocale24_8],
			planBilocale24,
		),
	},
	{
		title: 'Bilocale 5 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura e divano letto (due letti singoli)', 'Camera con letto matrimoniale e singolo', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planBilocale5,
		planIconAlt: 'Planimetria Bilocale 5 persone',
		gallery: buildGallery(
			'Bilocale 5 persone',
			[bilocale5_1, bilocale5_2, bilocale5_3, bilocale5_4, bilocale5_5, bilocale5_6, bilocale5_7, bilocale5_8],
			planBilocale5,
		),
	},
	{
		title: 'Trilocale 4 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura', 'Camera matrimoniale', 'Camera con due letti singoli', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planTrilocale4,
		planIconAlt: 'Planimetria Trilocale 4 persone',
		gallery: buildGallery(
			'Trilocale 4 persone',
			[trilocale4_1, trilocale4_2, trilocale4_3, trilocale4_4, trilocale4_5, trilocale4_6, trilocale4_7, trilocale4_8],
			planTrilocale4,
		),
	},
	{
		title: 'Trilocale 5 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura', 'Camera matrimoniale', 'Camera con letto singolo e divano letto (due letti singoli)', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planTrilocale5,
		planIconAlt: 'Planimetria Trilocale 5 persone',
		gallery: buildGallery(
			'Trilocale 5 persone',
			[trilocale5_1, trilocale5_2, trilocale5_3, trilocale5_4, trilocale5_5, trilocale5_6, trilocale5_7, trilocale5_8],
			planTrilocale5,
		),
	},
];
---

<BaseLayout
	title="Case Vacanza"
	description="Villette bilocali e trilocali immerse in un uliveto a Vieste, con aria condizionata, TV satellitare, cassaforte e ventilatori."
	currentPage="case-vacanza"
>
	<section class="page-header">
		<div class="container text-center">
			<span class="eyebrow">Le nostre villette</span>
			<h1>Case Vacanza</h1>
			<p class="intro-text text-justify">
				Villette bilocali e trilocali per soddisfare le richieste di ogni cliente. Tutte le unità
				includono aria condizionata (supplemento), frigo/freezer, TV satellitare, cassaforte e
				ventilatori a soffitto/piantana.
			</p>
		</div>
	</section>

	<section class="apartments-section">
		<div class="container">
			<ApartmentSelector
				apartments={apartments}
				prevLabel="Foto precedente"
				nextLabel="Foto successiva"
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 5em;
		padding-bottom: 3em;
	}

	.intro-text {
		max-width: 40em;
		margin: 1em auto 0;
	}

	.apartments-section {
		padding-top: 0;
	}
</style>
