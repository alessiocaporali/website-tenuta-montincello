---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApartmentSelector from '../../components/content/ApartmentSelector.astro';
import planBilocale24 from '../../assets/images/plan-bilocale-2-4.jpg';
import planBilocale5 from '../../assets/images/plan-bilocale-5.jpg';
import planTrilocale4 from '../../assets/images/plan-trilocale-4.jpg';
import planTrilocale5 from '../../assets/images/plan-trilocale-5.jpg';
import bilocale24_1 from '../../assets/images/apartment-bilocale-2-4.jpg';
import bilocale24_2 from '../../assets/images/apartment-bilocale-2-4-2.jpg';
import bilocale24_3 from '../../assets/images/apartment-bilocale-2-4-3.jpg';
import bilocale24_4 from '../../assets/images/apartment-bilocale-2-4-4.jpg';
import bilocale24_5 from '../../assets/images/apartment-bilocale-2-4-5.jpg';
import bilocale24_6 from '../../assets/images/apartment-bilocale-2-4-6.jpg';
import bilocale24_7 from '../../assets/images/apartment-bilocale-2-4-7.jpg';
import bilocale24_8 from '../../assets/images/apartment-bilocale-2-4-8.jpg';
import bilocale5_1 from '../../assets/images/apartment-bilocale-5.jpg';
import bilocale5_2 from '../../assets/images/apartment-bilocale-5-2.jpg';
import bilocale5_3 from '../../assets/images/apartment-bilocale-5-3.jpg';
import bilocale5_4 from '../../assets/images/apartment-bilocale-5-4.jpg';
import bilocale5_5 from '../../assets/images/apartment-bilocale-5-5.jpg';
import bilocale5_6 from '../../assets/images/apartment-bilocale-5-6.jpg';
import bilocale5_7 from '../../assets/images/apartment-bilocale-5-7.jpg';
import bilocale5_8 from '../../assets/images/apartment-bilocale-5-8.jpg';
import trilocale4_1 from '../../assets/images/apartment-trilocale-4.jpg';
import trilocale4_2 from '../../assets/images/apartment-trilocale-4-2.jpg';
import trilocale4_3 from '../../assets/images/apartment-trilocale-4-3.jpg';
import trilocale4_4 from '../../assets/images/apartment-trilocale-4-4.jpg';
import trilocale4_5 from '../../assets/images/apartment-trilocale-4-5.jpg';
import trilocale4_6 from '../../assets/images/apartment-trilocale-4-6.jpg';
import trilocale4_7 from '../../assets/images/apartment-trilocale-4-7.jpg';
import trilocale4_8 from '../../assets/images/apartment-trilocale-4-8.jpg';
import trilocale5_1 from '../../assets/images/apartment-trilocale-5.jpg';
import trilocale5_2 from '../../assets/images/apartment-trilocale-5-2.jpg';
import trilocale5_3 from '../../assets/images/apartment-trilocale-5-3.jpg';
import trilocale5_4 from '../../assets/images/apartment-trilocale-5-4.jpg';
import trilocale5_5 from '../../assets/images/apartment-trilocale-5-5.jpg';
import trilocale5_6 from '../../assets/images/apartment-trilocale-5-6.jpg';
import trilocale5_7 from '../../assets/images/apartment-trilocale-5-7.jpg';
import trilocale5_8 from '../../assets/images/apartment-trilocale-5-8.jpg';

function buildGallery(title: string, images: ImageMetadata[], plan: ImageMetadata) {
	return [
		...images.map((src, i) => ({ src, alt: i === 0 ? title : `${title}, photo ${i + 1}` })),
		{ src: plan, alt: `Floor plan, ${title}` },
	];
}

const apartments = [
	{
		title: 'Two-Room Apartment, 2-4 guests',
		rooms: ['Veranda', 'Living room with kitchenette and sofa bed (two single beds)', 'Master bedroom', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planBilocale24,
		planIconAlt: 'Floor plan, Two-Room Apartment 2-4 guests',
		gallery: buildGallery(
			'Two-Room Apartment, 2-4 guests',
			[bilocale24_1, bilocale24_2, bilocale24_3, bilocale24_4, bilocale24_5, bilocale24_6, bilocale24_7, bilocale24_8],
			planBilocale24,
		),
	},
	{
		title: 'Two-Room Apartment, 5 guests',
		rooms: ['Veranda', 'Living room with kitchenette and sofa bed (two single beds)', 'Bedroom with double and single bed', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planBilocale5,
		planIconAlt: 'Floor plan, Two-Room Apartment 5 guests',
		gallery: buildGallery(
			'Two-Room Apartment, 5 guests',
			[bilocale5_1, bilocale5_2, bilocale5_3, bilocale5_4, bilocale5_5, bilocale5_6, bilocale5_7, bilocale5_8],
			planBilocale5,
		),
	},
	{
		title: 'Three-Room Apartment, 4 guests',
		rooms: ['Veranda', 'Living room with kitchenette', 'Master bedroom', 'Twin bedroom', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planTrilocale4,
		planIconAlt: 'Floor plan, Three-Room Apartment 4 guests',
		gallery: buildGallery(
			'Three-Room Apartment, 4 guests',
			[trilocale4_1, trilocale4_2, trilocale4_3, trilocale4_4, trilocale4_5, trilocale4_6, trilocale4_7, trilocale4_8],
			planTrilocale4,
		),
	},
	{
		title: 'Three-Room Apartment, 5 guests',
		rooms: ['Veranda', 'Living room with kitchenette', 'Master bedroom', 'Bedroom with single bed and sofa bed (two single beds)', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planTrilocale5,
		planIconAlt: 'Floor plan, Three-Room Apartment 5 guests',
		gallery: buildGallery(
			'Three-Room Apartment, 5 guests',
			[trilocale5_1, trilocale5_2, trilocale5_3, trilocale5_4, trilocale5_5, trilocale5_6, trilocale5_7, trilocale5_8],
			planTrilocale5,
		),
	},
];
---

<BaseLayout
	title="Apartments"
	description="Two and three-room villas set in an olive grove in Vieste, with air conditioning, satellite TV, safe and fans."
	currentPage="case-vacanza"
>
	<section class="page-header">
		<div class="container text-center">
			<span class="eyebrow">Our villas</span>
			<h1>Holiday Homes</h1>
			<p class="intro-text text-justify">
				Two and three-room villas to meet every guest's needs. All units include air
				conditioning (surcharge), fridge/freezer, satellite TV, safe and ceiling/standing fans.
			</p>
		</div>
	</section>

	<section class="apartments-section">
		<div class="container">
			<ApartmentSelector apartments={apartments} prevLabel="Previous photo" nextLabel="Next photo" />
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 5em;
		padding-bottom: 3em;
	}

	.intro-text {
		max-width: 40em;
		margin: 1em auto 0;
	}

	.apartments-section {
		padding-top: 0;
	}
</style>
