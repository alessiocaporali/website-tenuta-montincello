import trilocale5_7 from '../../assets/images/trilo5/trilo_5_7.jpeg';
import trilocale5_8 from '../../assets/images/trilo5/trilo5_8.jpeg';

function buildGallery(title: string, images: ImageMetadata[], plan: ImageMetadata) {
	return [
		...images.map((src, i) => ({ src, alt: i === 0 ? title : `${title}, photo ${i + 1}` })),
		{ src: plan, alt: `Floor plan, ${title}` },
	];
}

const apartments = [
	{
		title: 'Two-Room Apartment, 2-4 guests',
		rooms: ['Veranda', 'Living room with kitchenette and sofa bed (two single beds)', 'Master bedroom', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planBilocale24,
		planIconAlt: 'Floor plan, Two-Room Apartment 2-4 guests',
		gallery: buildGallery(
			'Two-Room Apartment, 2-4 guests',
			[bilocale24_1, bilocale24_2, bilocale24_3, bilocale24_4, bilocale24_5, bilocale24_6, bilocale24_7, bilocale24_8],
			planBilocale24,
		),
	},
	{
		title: 'Two-Room Apartment, 5 guests',
		rooms: ['Veranda', 'Living room with kitchenette and sofa bed (two single beds)', 'Bedroom with double and single bed', 'Bathroom'],
		photoNote: '8 photos',
		planIcon: planBilocale5,
		planIconAlt: 'Floor plan, Two-Room Apartment 5 guests',
		gallery: buildGallery(
			'Two-Room Apartment, 5 guests',
			[bilocale5_1, bilocale5_2, bilocale5_3, bilocale5_4, bilocale5_5, bilocale5_6, bilocale5_7],
			planBilocale5,
		),
	},
	{
		title: 'Three-Room Apartment, 4 guests',
		rooms: ['Veranda', 'Living room with kitchenette', 'Master bedroom', 'Twin bedroom', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planTrilocale4,
		planIconAlt: 'Floor plan, Three-Room Apartment 4 guests',
		gallery: buildGallery(
			'Three-Room Apartment, 4 guests',
			[trilocale4_1, trilocale4_2, trilocale4_3, trilocale4_4, trilocale4_5, trilocale4_6, trilocale4_7, trilocale4_8],
			planTrilocale4,
		),
	},
	{
		title: 'Three-Room Apartment, 5 guests',
		rooms: ['Veranda', 'Living room with kitchenette', 'Master bedroom', 'Bedroom with single bed and sofa bed (two single beds)', 'Bathroom'],
		photoNote: '9 photos',
		planIcon: planTrilocale5,
		planIconAlt: 'Floor plan, Three-Room Apartment 5 guests',
		gallery: buildGallery(
			'Three-Room Apartment, 5 guests',
			[trilocale5_1, trilocale5_2, trilocale5_3, trilocale5_4, trilocale5_5, trilocale5_6, trilocale5_7, trilocale5_8],
			planTrilocale5,
		),
	},
];

const priceRows = [
	{ period: 'until 12/06', prices: [250, 300, 350, 400, 400, 450] },
	{ period: '13/06 – 26/06', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '27/06 – 10/07', prices: [350, 400, 450, 500, 500, 550] },
	{ period: '11/07 – 24/07', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '25/07 – 31/07', prices: [500, 550, 600, 650, 650, 700] },
	{ period: '01/08 – 07/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '08/08 – 21/08', prices: [800, 850, 900, 950, 950, 1000] },
	{ period: '22/08 – 28/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '29/08 – 04/09', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '05/09 – 11/09', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '12/09 - 26/09', prices: [250, 300, 350, 400, 400, 450] },
];
---

<BaseLayout
	title="Tenuta Montincello"
	description="Holiday homes surrounded by an olive grove in Vieste, in the heart of the Gargano National Park, 900 metres from Scialmarino Bay."
	currentPage="home"
>
	<Hero
		eyebrow="Holiday homes in the green of an olive grove"
		title="Your holiday in Vieste, in the heart of Gargano!"
		subtitle="Villas set within a 4,000 sqm olive grove, just steps from the sea and the Gargano National Park."
		ctaPrimary={{ href: '#case-vacanza', label: 'Discover the Holiday Homes' }}
		ctaSecondary={{ href: '#contact', label: 'Request Information' }}
		imageAlt="Olive grove at Tenuta Montincello in Vieste"
	/>

	<Welcome
		eyebrow="Welcome"
		title="Tenuta Montincello"
		images={[
			{ src: welcome1, alt: 'The main villa at Tenuta Montincello among the olive trees' },
			{ src: welcome2, alt: 'The barbecue and playground area at the estate' },
			{ src: welcome3, alt: 'The relax gazebo at the estate among the olive trees' },
		]}
		paragraphs={[
			'Tenuta Montincello is located within the municipality of Vieste, in the heart of the Gargano National Park, in one of the most striking corners of Puglia. It is just 900 metres from Scialmarino Bay, considered one of the most beautiful beaches in Vieste and the whole of Gargano, with fine sand and crystal-clear water.',
			'Tenuta Montincello is only 6 km from Vieste, in an area rich in history and charm, home to the ancient Church of Santa Maria di Merino and the Salata Necropolis. The entrance to the Umbra Forest is easily reached in just 12 km.',
			'Tenuta Montincello is ready to welcome you with open arms, for a stay devoted to nature, history and relaxation.',
		]}
	/>

	<Surroundings
		eyebrow="Nearby"
		title="What to discover near the estate"
		places={[
			{
				label: 'Vieste',
				image: dintorniVieste,
				imageAlt: 'The historic centre of Vieste by the sea',
				description: 'Vieste is the pearl of the Gargano: a whitewashed old town overlooking the sea, golden beaches and the famous Pizzomunno sea stack.',
			},
			{
				label: 'Scialmarino Bay',
				image: dintorniMare,
				imageAlt: 'The sea at Scialmarino Bay',
				description: "One of Vieste's best-loved beaches, with fine sand and crystal-clear water just a short walk from the estate.",
			},
			{
				label: 'Umbra Forest',
				image: dintorniForesta,
				imageAlt: 'The Umbra Forest in the Gargano National Park',
				description: 'The green heart of the Gargano National Park: an ancient beech forest full of trails and wildlife, cool even in summer.',
			},
		]}
	/>

	<WhyUs
		eyebrow="Our strengths"
		title="Why choose us"
		items={[
			{ image: iconUliveto, alt: 'Olive grove icon', label: '4,000 sqm olive grove' },
			{ image: iconCaseVacanza, alt: 'Holiday homes icon', label: '5 holiday homes' },
			{ image: iconMare, alt: 'Sea icon', label: 'Sea 900 m away, Scialmarino Bay' },
			{ image: iconGiochi, alt: 'Playground icon', label: "Children's playground" },
			{ image: iconBbq, alt: 'Barbecue icon', label: 'Barbecue area' },
		]}
	/>

	<HolidayHomesOverview
		eyebrow="The Holiday Homes"
		title="Holiday homes surrounded by greenery"
		text={[
			'Tenuta Montincello, directly managed by the owners, produces Extra Virgin Olive Oil and offers modern, newly built holiday homes. The fully furnished, air-conditioned villas, equipped with every comfort, are set within a 4,000 sqm olive grove, ideal for those seeking relaxation and contact with nature. One and two-bedroom options are available to suit different stay requirements.',
			'Two and three-room villas to meet every guest’s needs. All units include air conditioning (surcharge), fridge/freezer, satellite TV, safe and ceiling/standing fans.',
		]}
		images={[
			{ src: caseVacanza1, alt: 'Holiday home surrounded by the olive grove' },
			{ src: caseVacanza2, alt: 'Entrance of a holiday home' },
			{ src: caseVacanza3, alt: 'Exterior of a holiday home' },
			{ src: caseVacanza4, alt: 'Villa among the olive trees of the estate' },
		]}
		apartments={apartments}
		prevLabel="Previous photo"
		nextLabel="Next photo"
	/>

	<PriceSection
		eyebrow="Rates"
		title="Price List"
		intro="Weekly prices in euros. They include utilities (water, electricity, gas), a parking space and use of the kitchenette."
		periodLabel="Period"
		columns={['2-room 2p', '2-room 3p', '2-room 4p', '2-room 5p', '3-room 4p', '3-room 5p']}
		rows={priceRows}
		supplementsTitle="Extras"
		supplements={[
			{ label: 'Air conditioning', value: '€10 / day' },
			{ label: 'Pet surcharge', value: '€100 / week' },
			{ label: 'Bed linen (per person)', value: '€7.50' },
			{ label: 'Bath linen (per person)', value: '€7.50' },
			{ label: 'Final cleaning', value: '€50' },
			{ label: 'Security deposit', value: '€200' },
		]}
		taxTitle="Tourist Tax"
		taxText="A municipal tourist tax applies: <strong>€1.00 per person per day</strong> from October to May, <strong>€2.50 per person per day</strong> from June to September, for guests aged 14 and over. The tax applies for a maximum of 10 days per person and is payable on site."
	/>

	<ServicesOffered
		eyebrow="Available to guests"
		title="Services Offered"
		services={[
			{ label: "Children's playground", image: serviziGiochi, imageAlt: "Children's playground at the estate" },
			{ label: 'Relaxation area with billiards and ping pong', image: serviziRelax, imageAlt: 'Relaxation area with billiards at the estate' },
			{ label: 'Barbecue area', image: serviziBbq, imageAlt: 'Barbecue area at the estate' },
		]}
	/>

	<ContactInfo
		eyebrow="Where we are"
		title="Contact"
		addressLabel="Address"
		mapEmbedTitle="Map of Tenuta Montincello"
		mapUrl="https://www.google.com/maps/place/Tenuta+Montincello/@41.9084405,16.1097578,17z/data=!4m24!1m12!3m11!1s0x1337c8141669d605:0x7cf28d14d9661ac4!2sTenuta+Montincello!5m4!1s2026-10-30!2i3!4m1!1i2!8m2!3d41.9084365!4d16.1123327!16s%2Fg%2F1td8n18m!3m10!1s0x1337c8141669d605:0x7cf28d14d9661ac4!5m4!1s2026-10-30!2i3!4m1!1i2!8m2!3d41.9084365!4d16.1123327!16s%2Fg%2F1td8n18m!5m1!1e2?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
	/>
</BaseLayout>
