---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/content/GalleryGrid.astro';
import gallery1 from '../../assets/images/gallery/0.jpeg';
import gallery2 from '../../assets/images/gallery/1.jpeg';
import gallery3 from '../../assets/images/gallery/2.jpeg';
import gallery4 from '../../assets/images/gallery/3.jpg';
import gallery5 from '../../assets/images/gallery/4.jpg';
import gallery6 from '../../assets/images/gallery/5.jpeg';
import gallery7 from '../../assets/images/gallery/6.jpg';
import gallery8 from '../../assets/images/gallery/7.jpg';
import gallery9 from '../../assets/images/gallery/8.jpg';
import gallery10 from '../../assets/images/gallery/9.jpg';

const images = [
	{ src: gallery1, alt: 'Tenuta Montincello, photo 1' },
	{ src: gallery2, alt: 'Tenuta Montincello, photo 2' },
	{ src: gallery3, alt: 'Tenuta Montincello, photo 3' },
	{ src: gallery4, alt: 'Tenuta Montincello, photo 4' },
	{ src: gallery5, alt: 'Tenuta Montincello, photo 5' },
	{ src: gallery6, alt: 'Tenuta Montincello, photo 6' },
	{ src: gallery7, alt: 'Tenuta Montincello, photo 7' },
	{ src: gallery8, alt: 'Tenuta Montincello, photo 8' },
	{ src: gallery9, alt: 'Tenuta Montincello, photo 9' },
	{ src: gallery10, alt: 'Tenuta Montincello, photo 10' },
];
---

<BaseLayout
	title="Photo Gallery"
	description="Photos and videos of Tenuta Montincello, holiday homes in the green of an olive grove in Vieste."
	currentPage="galleria-immagini"
>
	<section class="page-header">
		<div class="container text-center">
			<span class="eyebrow">Discover the estate</span>
			<h1>Photo Gallery</h1>
		</div>
	</section>

	<section class="gallery-section">
		<div class="container">
			<GalleryGrid
				images={images}
				prevLabel="Previous photo"
				nextLabel="Next photo"
				videos={[
					{ youtubeId: 'AuTeRKHkNtE', title: 'Flying Over the Estate' },
					{ youtubeId: 'CPaS-_1ptLA', title: 'A Walk Through the Estate' },
				]}
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 5em;
		padding-bottom: 2em;
	}

	.gallery-section {
		padding-top: 0;
	}
</style>
