---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PriceTable from '../../components/content/PriceTable.astro';

const rows = [
	{ period: 'until 12/06', prices: [250, 300, 350, 400, 400, 450] },
	{ period: '13/06 – 26/06', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '27/06 – 10/07', prices: [350, 400, 450, 500, 500, 550] },
	{ period: '11/07 – 24/07', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '25/07 – 31/07', prices: [500, 550, 600, 650, 650, 700] },
	{ period: '01/08 – 07/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '08/08 – 21/08', prices: [800, 850, 900, 950, 950, 1000] },
	{ period: '22/08 – 28/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '29/08 – 04/09', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '05/09 – 11/09', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '12/09 - 26/09', prices: [250, 300, 350, 400, 400, 450] },
];
---

<BaseLayout
	title="Prices"
	description="Weekly rates for Tenuta Montincello holiday homes in Vieste, Gargano."
	currentPage="listino-prezzi"
>
	<section class="page-header">
		<div class="container text-center">
			<span class="eyebrow">Rates</span>
			<h1>Price List</h1>
			<p class="intro-text">
				Weekly prices in euros. They include utilities (water, electricity, gas), a parking
				space and use of the kitchenette.
			</p>
		</div>
	</section>

	<section class="price-section">
		<div class="container">
			<PriceTable
				periodLabel="Period"
				columns={['2-room 2p', '2-room 3p', '2-room 4p', '2-room 5p', '3-room 4p', '3-room 5p']}
				rows={rows}
			/>

			<h2>Extras</h2>
			<div class="supplements-list">
				<div class="supplement-row"><span>Air conditioning</span><strong>€10 / day</strong></div>
				<div class="supplement-row"><span>Pet surcharge</span><strong>€100 / week</strong></div>
				<div class="supplement-row"><span>Bed linen (per person)</span><strong>€7.50</strong></div>
				<div class="supplement-row"><span>Bath linen (per person)</span><strong>€7.50</strong></div>
				<div class="supplement-row"><span>Final cleaning</span><strong>€50</strong></div>
				<div class="supplement-row"><span>Security deposit</span><strong>€200</strong></div>
			</div>

			<h2>Tourist Tax</h2>
			<p class="text-justify">
				A municipal tourist tax applies: <strong>€1.00 per person per day</strong> from October
				to May, <strong>€2.50 per person per day</strong> from June to September, for guests
				aged 14 and over. The tax applies for a maximum of 10 days per person and is payable on
				site.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 5em;
		padding-bottom: 2em;
	}

	.intro-text {
		max-width: 36em;
		margin: 1em auto 0;
	}

	.price-section {
		padding-top: 0;
	}

	.price-section h2 {
		margin-top: 2em;
	}

	.supplements-list {
		max-width: 30em;
		margin: 1.5em 0 2em;
	}

	.supplement-row {
		display: flex;
		justify-content: space-between;
		padding: 0.6em 0;
		border-bottom: 1px solid var(--color-border-bg);
	}
</style>
