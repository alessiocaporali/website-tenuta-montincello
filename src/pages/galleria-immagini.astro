---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/content/GalleryGrid.astro';
import gallery1 from '../assets/images/gallery/0.jpeg';
import gallery2 from '../assets/images/gallery/1.jpeg';
import gallery3 from '../assets/images/gallery/2.jpeg';
import gallery4 from '../assets/images/gallery/3.jpg';
import gallery5 from '../assets/images/gallery/4.jpg';
import gallery6 from '../assets/images/gallery/5.jpeg';
import gallery7 from '../assets/images/gallery/6.jpg';
import gallery8 from '../assets/images/gallery/7.jpg';
import gallery9 from '../assets/images/gallery/8.jpg';
import gallery10 from '../assets/images/gallery/9.jpg';

const images = [
	{ src: gallery1, alt: 'La Tenuta Montincello, foto 1' },
	{ src: gallery2, alt: 'La Tenuta Montincello, foto 2' },
	{ src: gallery3, alt: 'La Tenuta Montincello, foto 3' },
	{ src: gallery4, alt: 'La Tenuta Montincello, foto 4' },
	{ src: gallery5, alt: 'La Tenuta Montincello, foto 5' },
	{ src: gallery6, alt: 'La Tenuta Montincello, foto 6' },
	{ src: gallery7, alt: 'La Tenuta Montincello, foto 7' },
	{ src: gallery8, alt: 'La Tenuta Montincello, foto 8' },
	{ src: gallery9, alt: 'La Tenuta Montincello, foto 9' },
	{ src: gallery10, alt: 'La Tenuta Montincello, foto 10' },
];
---

<BaseLayout
	title="Galleria Immagini"
	description="Foto e video della Tenuta Montincello, le case vacanza nel verde di un uliveto a Vieste."
	currentPage="galleria-immagini"
>
	<section class="page-header">
		<div class="container text-center">
			<span class="eyebrow">Scopri la Tenuta</span>
			<h1>Galleria Immagini</h1>
		</div>
	</section>

	<section class="gallery-section">
		<div class="container">
			<GalleryGrid
				images={images}
				prevLabel="Foto precedente"
				nextLabel="Foto successiva"
				videos={[
					{ youtubeId: 'AuTeRKHkNtE', title: 'In Volo Sulla Tenuta' },
					{ youtubeId: 'CPaS-_1ptLA', title: 'A Spasso Nella Tenuta' },
				]}
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: 5em;
		padding-bottom: 2em;
	}

	.gallery-section {
		padding-top: 0;
	}
</style>
