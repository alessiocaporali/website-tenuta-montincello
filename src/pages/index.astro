---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Welcome from '../components/landing/Welcome.astro';
import Surroundings from '../components/landing/Surroundings.astro';
import WhyUs from '../components/landing/WhyUs.astro';
import HolidayHomesOverview from '../components/landing/HolidayHomesOverview.astro';
import PriceSection from '../components/landing/PriceSection.astro';
import ServicesOffered from '../components/landing/ServicesOffered.astro';
import ContactInfo from '../components/landing/ContactInfo.astro';
import welcome1 from '../assets/images/welcome-1.jpg';
import welcome2 from '../assets/images/welcome2_new.jpeg';
import welcome3 from '../assets/images/welcome3_new.jpg';
import caseVacanza1 from '../assets/images/case-vacanza-1.jpg';
import caseVacanza2 from '../assets/images/case-vacanza-2.jpg';
import caseVacanza3 from '../assets/images/case-vacanza-3.jpg';
import caseVacanza4 from '../assets/images/case-vacanza-4.jpg';
import serviziGiochi from '../assets/images/servizi-giochi_new.jpg';
import serviziBbq from '../assets/images/servizi-bbq_new.jpg';
import dintorniVieste from '../assets/images/dintorni-vieste.jpg';
import dintorniMare from '../assets/images/dintorni-mare.jpg';
import dintorniForesta from '../assets/images/dintorni-foresta.jpg';
import iconUliveto from '../assets/images/cards/icon-uliveto.png';
import iconCaseVacanza from '../assets/images/cards/icon-case-vacanza.png';
import iconMare from '../assets/images/cards/icon-mare.png';
import iconGiochi from '../assets/images/cards/icon-giochi.png';
import iconBbq from '../assets/images/cards/icon-bbq.png';
import planBilocale24 from '../assets/images/plan-bilocale-2-4.jpg';
import planBilocale5 from '../assets/images/plan-bilocale-5.jpg';
import planTrilocale4 from '../assets/images/plan-trilocale-4.jpg';
import planTrilocale5 from '../assets/images/plan-trilocale-5.jpg';
import bilocale24_1 from '../assets/images/apartment-bilocale-2-4.jpg';
import bilocale24_2 from '../assets/images/apartment-bilocale-2-4-2.jpg';
import bilocale24_3 from '../assets/images/apartment-bilocale-2-4-3.jpg';
import bilocale24_4 from '../assets/images/apartment-bilocale-2-4-4.jpg';
import bilocale24_5 from '../assets/images/apartment-bilocale-2-4-5.jpg';
import bilocale24_6 from '../assets/images/apartment-bilocale-2-4-6.jpg';
import bilocale24_7 from '../assets/images/apartment-bilocale-2-4-7.jpg';
import bilocale24_8 from '../assets/images/apartment-bilocale-2-4-8.jpg';
import bilocale5_1 from '../assets/images/bilo5/bilo5_0.jpg';
import bilocale5_2 from '../assets/images/bilo5/bilo5_1.jpeg';
import bilocale5_3 from '../assets/images/bilo5/bilo5_2.jpeg';
import bilocale5_4 from '../assets/images/bilo5/bilo5_3.jpeg';
import bilocale5_5 from '../assets/images/bilo5/bilo5_4.jpeg';
import bilocale5_6 from '../assets/images/bilo5/bilo5_5.jpg';
import bilocale5_7 from '../assets/images/bilo5/bilo5_6.jpeg';
import trilocale4_1 from '../assets/images/apartment-trilocale-4.jpg';
import trilocale4_2 from '../assets/images/apartment-trilocale-4-2.jpg';
import trilocale4_3 from '../assets/images/apartment-trilocale-4-3.jpg';
import trilocale4_4 from '../assets/images/apartment-trilocale-4-4.jpg';
import trilocale4_5 from '../assets/images/apartment-trilocale-4-5.jpg';
import trilocale4_6 from '../assets/images/apartment-trilocale-4-6.jpg';
import trilocale4_7 from '../assets/images/apartment-trilocale-4-7.jpg';
import trilocale4_8 from '../assets/images/apartment-trilocale-4-8.jpg';
import trilocale5_1 from '../assets/images/trilo5/trilo5_1.jpeg';
import trilocale5_2 from '../assets/images/trilo5/trilo5_2.jpeg';
import trilocale5_3 from '../assets/images/trilo5/trilo5_3.jpeg';
import trilocale5_4 from '../assets/images/trilo5/trilo5_4.jpeg';
import trilocale5_5 from '../assets/images/trilo5/trilo5_5.jpeg';
import trilocale5_6 from '../assets/images/trilo5/trilo5_6.jpg';
import trilocale5_7 from '../assets/images/trilo5/trilo5_7.jpeg';
import trilocale5_8 from '../assets/images/trilo5/trilo5_8.jpeg';

function buildGallery(title: string, images: ImageMetadata[], plan: ImageMetadata) {
	return [
		...images.map((src, i) => ({ src, alt: i === 0 ? title : `${title}, foto ${i + 1}` })),
		{ src: plan, alt: `Planimetria, ${title}` },
	];
}

const apartments = [
	{
		title: 'Bilocale 2-4 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura e divano letto (due letti singoli)', 'Camera matrimoniale', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planBilocale24,
		planIconAlt: 'Planimetria Bilocale 2-4 persone',
		gallery: buildGallery(
			'Bilocale 2-4 persone',
			[bilocale24_1, bilocale24_2, bilocale24_3, bilocale24_4, bilocale24_5, bilocale24_6, bilocale24_7, bilocale24_8],
			planBilocale24,
		),
	},
	{
		title: 'Bilocale 5 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura e divano letto (due letti singoli)', 'Camera con letto matrimoniale e singolo', 'Bagno'],
		photoNote: '8 foto',
		planIcon: planBilocale5,
		planIconAlt: 'Planimetria Bilocale 5 persone',
		gallery: buildGallery(
			'Bilocale 5 persone',
			[bilocale5_1, bilocale5_2, bilocale5_3, bilocale5_4, bilocale5_5, bilocale5_6, bilocale5_7],
			planBilocale5,
		),
	},
	{
		title: 'Trilocale 4 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura', 'Camera matrimoniale', 'Camera con due letti singoli', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planTrilocale4,
		planIconAlt: 'Planimetria Trilocale 4 persone',
		gallery: buildGallery(
			'Trilocale 4 persone',
			[trilocale4_1, trilocale4_2, trilocale4_3, trilocale4_4, trilocale4_5, trilocale4_6, trilocale4_7, trilocale4_8],
			planTrilocale4,
		),
	},
	{
		title: 'Trilocale 5 persone',
		rooms: ['Veranda', 'Soggiorno con angolo cottura', 'Camera matrimoniale', 'Camera con letto singolo e divano letto (due letti singoli)', 'Bagno'],
		photoNote: '9 foto',
		planIcon: planTrilocale5,
		planIconAlt: 'Planimetria Trilocale 5 persone',
		gallery: buildGallery(
			'Trilocale 5 persone',
			[trilocale5_1, trilocale5_2, trilocale5_3, trilocale5_4, trilocale5_5, trilocale5_6, trilocale5_7, trilocale5_8],
			planTrilocale5,
		),
	},
];

const priceRows = [
	{ period: 'fino al 12/06', prices: [250, 300, 350, 400, 400, 450] },
	{ period: '13/06 – 26/06', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '27/06 – 10/07', prices: [350, 400, 450, 500, 500, 550] },
	{ period: '11/07 – 24/07', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '25/07 – 31/07', prices: [500, 550, 600, 650, 650, 700] },
	{ period: '01/08 – 07/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '08/08 – 21/08', prices: [800, 850, 900, 950, 950, 1000] },
	{ period: '22/08 – 28/08', prices: [700, 750, 800, 850, 850, 900] },
	{ period: '29/08 – 04/09', prices: [400, 450, 500, 550, 550, 600] },
	{ period: '05/09 – 11/09', prices: [300, 350, 400, 450, 450, 500] },
	{ period: '12/09 - 26/09', prices: [250, 300, 350, 400, 400, 450] },
];
---

<BaseLayout
	title="Tenuta Montincello"
	description="Case vacanza immerse in un uliveto a Vieste, nel cuore del Parco Nazionale del Gargano, a 900 metri dalla Baia di Scialmarino."
	currentPage="home"
>
	<Hero
		eyebrow="Case vacanze nel verde di un uliveto"
		title={`La tua vacanza a Vieste,\nnel cuore del Gargano!`}
		subtitle="Villette immerse in un uliveto di 4.000 mq, a due passi dal mare e dal Parco Nazionale del Gargano."
		ctaPrimary={{ href: '#case-vacanza', label: 'Scopri le Case Vacanza' }}
		ctaSecondary={{ href: '#contact', label: 'Richiedi Informazioni' }}
		imageAlt="Uliveto della Tenuta Montincello a Vieste"
	/>

	<Welcome
		eyebrow="Benvenuti"
		title="La Tenuta Montincello"
		images={[
			{ src: welcome1, alt: 'La villa principale della Tenuta Montincello tra gli ulivi' },
			{ src: welcome2, alt: "L'area barbecue e parco giochi della Tenuta" },
			{ src: welcome3, alt: 'Il gazebo relax della Tenuta tra gli ulivi' },
		]}
		paragraphs={[
			'La Tenuta Montincello si trova nel territorio del Comune di Vieste, nel cuore del Parco Nazionale del Gargano, in uno degli angoli più suggestivi della Puglia. Dista appena 900 metri dalla Baia di Scialmarino, considerata tra le spiagge più belle di Vieste e dell’intero Gargano, caratterizzata da sabbia finissima e mare cristallino.',
			'La Tenuta Montincello si trova a soli 6 km da Vieste, in un territorio ricco di storia e fascino, dove sorgono l’antica chiesa di Santa Maria di Merino e la Necropoli della Salata. L’ingresso della Foresta Umbra è facilmente raggiungibile in appena 12 km.',
			'La Tenuta Montincello è pronta ad accogliervi a braccia aperte, per regalarvi un soggiorno all’insegna della natura, della storia e del relax.',
		]}
	/>

	<Surroundings
		eyebrow="Nei dintorni"
		title="Cosa scoprire vicino alla Tenuta"
		places={[
			{
				label: 'Vieste',
				image: dintorniVieste,
				imageAlt: 'Il centro storico di Vieste sul mare',
				description: 'Vieste è la perla del Gargano: un centro storico bianco a picco sul mare, spiagge dorate e il celebre faraglione di Pizzomunno.',
			},
			{
				label: 'Baia di Scialmarino',
				image: dintorniMare,
				imageAlt: 'Il mare della Baia di Scialmarino',
				description: "Una delle spiagge più amate di Vieste, con sabbia fine e acque cristalline, a pochi passi dalla Tenuta.",
			},
			{
				label: 'Foresta Umbra',
				image: dintorniForesta,
				imageAlt: 'La Foresta Umbra nel Parco Nazionale del Gargano',
				description: 'Il cuore verde del Parco Nazionale del Gargano: una faggeta millenaria ricca di sentieri e fauna selvatica, fresca anche in estate.',
			},
		]}
	/>

	<WhyUs
		eyebrow="I nostri punti di forza"
		title="Perché scegliere noi"
		items={[
			{ image: iconUliveto, alt: 'Icona uliveto', label: 'Uliveto di 4.000 mq' },
			{ image: iconCaseVacanza, alt: 'Icona case vacanza', label: '5 case vacanza' },
			{ image: iconMare, alt: 'Icona mare', label: 'Mare a 900 metri, Baia di Scialmarino' },
			{ image: iconGiochi, alt: 'Icona parco giochi', label: 'Parco giochi per bambini' },
			{ image: iconBbq, alt: 'Icona barbecue', label: 'Area barbecue' },
		]}
	/>

	<HolidayHomesOverview
		eyebrow="Le Case Vacanza"
		title="Case vacanza immerse nel verde"
		text={[
			'La Tenuta Montincello, gestita direttamente dai proprietari, oltre a produrre Olio Extravergine di Oliva, offre case vacanze immerse nel verde. Le villette, completamente arredate, climatizzate e dotate di ogni comfort, sono immerse nel verde di un uliveto di 4.000 mq, ideale per chi desidera relax e contatto con la natura. Sono disponibili soluzioni con una o due camere da letto, adatte a diverse esigenze di soggiorno.',
			"Villette bilocali e trilocali per soddisfare le richieste di ogni cliente. Tutte le unità includono aria condizionata (supplemento), frigo/freezer, TV satellitare, cassaforte e ventilatori a soffitto/piantana.",
		]}
		images={[
			{ src: caseVacanza1, alt: 'Casa vacanza immersa nell’uliveto' },
			{ src: caseVacanza2, alt: 'Ingresso di una casa vacanza' },
			{ src: caseVacanza3, alt: 'Esterno di una casa vacanza' },
			{ src: caseVacanza4, alt: 'Villetta tra gli ulivi della Tenuta' },
		]}
		apartments={apartments}
		prevLabel="Foto precedente"
		nextLabel="Foto successiva"
	/>

	<PriceSection
		eyebrow="Tariffe"
		title="Listino Prezzi"
		intro="Prezzi settimanali in euro. Includono i consumi (acqua, luce, gas), posto auto e uso dell'angolo cottura."
		periodLabel="Periodo"
		columns={['Bilo 2p', 'Bilo 3p', 'Bilo 4p', 'Bilo 5p', 'Trilo 4p', 'Trilo 5p']}
		rows={priceRows}
		supplementsTitle="Supplementi"
		supplements={[
			{ label: 'Supplemento aria condizionata', value: '10 € / giorno' },
			{ label: 'Supplemento animale', value: '100 € / settimana' },
			{ label: 'Biancheria da letto (a persona)', value: '7,50 €' },
			{ label: 'Biancheria da bagno (a persona)', value: '7,50 €' },
			{ label: 'Pulizia finale', value: '50 €' },
			{ label: 'Deposito cauzionale', value: '200 €' },
		]}
		taxTitle="Imposta di soggiorno"
		taxText="È dovuta l'imposta di soggiorno comunale: <strong>1,00 € a persona al giorno</strong> nel periodo ottobre–maggio, <strong>2,50 € a persona al giorno</strong> nel periodo giugno–settembre, per ospiti dai 14 anni in su. L'imposta si applica per un massimo di 10 giorni a persona e va corrisposta in loco."
	/>

	<ServicesOffered
		eyebrow="A disposizione degli ospiti"
		title="Servizi Offerti"
		services={[
			{ label: 'Parco giochi per bambini', image: serviziGiochi, imageAlt: 'Parco giochi per bambini nella Tenuta' },
			{ label: 'Aree barbecue', image: serviziBbq, imageAlt: 'Area barbecue della Tenuta' },
		]}
	/>

	<ContactInfo
		eyebrow="Dove siamo"
		title="Contatti"
		addressLabel=""
		mapEmbedTitle="Mappa della Tenuta Montincello"
		mapUrl="https://www.google.com/maps/place/Tenuta+Montincello/@41.9084405,16.1097578,17z/data=!4m24!1m12!3m11!1s0x1337c8141669d605:0x7cf28d14d9661ac4!2sTenuta+Montincello!5m4!1s2026-10-30!2i3!4m1!1i2!8m2!3d41.9084365!4d16.1123327!16s%2Fg%2F1td8n18m!3m10!1s0x1337c8141669d605:0x7cf28d14d9661ac4!5m4!1s2026-10-30!2i3!4m1!1i2!8m2!3d41.9084365!4d16.1123327!16s%2Fg%2F1td8n18m!5m1!1e2?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
	/>
</BaseLayout>
